*.py[cod]

# Blockchain node: the CI-downloaded binary and any local chain database.
# Both are large and machine-specific; the binary comes from the
# "Blockchain node release binary" workflow, the chain data from
# `run-dev-node.sh --persist`.
.node-bin/
# All local chain databases and node logs. Nothing under data/ is tracked.
/data/

# Playwright run output and the screenshots captured during browser-driven
# testing. These are per-run artifacts, not source: committing them churns the
# diff on every test pass and the images are regenerated on demand.
# Playwright run artifacts. The glob matters: these live per workspace
# (client/doctor-portal/test-results/), not at client/ — the previous
# non-globbed patterns matched neither, and .last-run.json was committed.
client/**/test-results/
client/**/playwright-report/
client/**/*.png
*.png
fix-results.tsv

# Browser-test identity fixtures: throwaway synthetic credentials and
# recovery phrases. Regenerate with scripts/seed-browser-test-fixtures.ts;
# never commit them.
.browser-test/

# Playwright saved sign-in state (contains a live session token)
client/**/.auth/
