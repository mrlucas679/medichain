# ==============================================================================
# MediChain Environment Configuration
# Copy this file to .env and customize for your environment
# ==============================================================================

# Database Configuration
DATABASE_URL=postgresql://medichain:medichain_dev_2024@localhost:5432/medichain

# For Docker internal networking (when API runs in container)
DATABASE_URL_DOCKER=postgresql://medichain:medichain_dev_2024@postgres:5432/medichain

# ------------------------------------------------------------------------------
# docker-compose credentials (interpolated by docker-compose.yml)
# The compose file ships DEV-ONLY defaults; override ALL of these in production.
# ------------------------------------------------------------------------------
POSTGRES_USER=medichain
POSTGRES_PASSWORD=medichain_dev_2024
POSTGRES_DB=medichain
PGADMIN_DEFAULT_EMAIL=admin@medichain.dev
PGADMIN_DEFAULT_PASSWORD=admin
METRICS_TOKEN=

# Application Configuration
RUST_LOG=info,sqlx=warn,medichain_api=debug
MEDICHAIN_DEV_MODE=true

# Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT_SECS=3
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800

# Connection Retry (for Docker startup timing)
DB_MAX_RETRIES=5

# Security (CHANGE IN PRODUCTION!)
# When IS_DEMO=false, the API refuses to start if these still hold demo values.
JWT_SECRET=medichain-demo-secret-key-change-in-production-2024
SESSION_SECRET=medichain-dev-secret-change-in-production
SESSION_DURATION_HOURS=24

# ------------------------------------------------------------------------------
# PHI encryption keyring (Phase 6.3 — key rotation)
# ------------------------------------------------------------------------------
# Format: "version:base64key,version:base64key,...". Each key must decode to
# exactly 32 bytes (e.g. `openssl rand -base64 32`). The highest version number
# is the "current" key: new writes encrypt with it and stamp that version on
# the row; reads decrypt with whichever version the row was stamped with, so
# rotating in a new version is additive — existing rows migrate lazily to the
# new version the next time they're written, no bulk re-encryption pass needed.
# UNSET IN PRODUCTION = an ephemeral key generated fresh on every process start,
# which silently makes all previously-encrypted PHI undecryptable after any
# restart. IS_DEMO=false refuses to start without this set (see startup.rs).
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEYS=1:REPLACE_WITH_A_REAL_openssl_rand_-base64_32_OUTPUT=

# SECURE BY DEFAULT: the API enables wallet signature verification unless you
# opt out. IS_DEMO=true disables bound per-request signature verification (so
# X-User-Id alone is accepted) and relaxes startup secret validation — for
# LOCAL/DEMO ONLY. JWT issuance still requires a signed wallet challenge.
# Set IS_DEMO=false for production (the default when this var is unset).
# Override precedence: REQUIRE_SIGNATURES=true|false overrides the IS_DEMO default.
IS_DEMO=true
APP_ENV=development

# Blockchain Node (Substrate)
SUBSTRATE_WS_URL=ws://127.0.0.1:9944
BLOCKCHAIN_ENABLED=false
# Production operator secret URI/seed. Never commit a real value.
SUBSTRATE_SIGNING_KEY=
# Local demo only; production startup rejects this as a substitute for an operator key.
SUBSTRATE_ALLOW_DEV_SIGNER=true

# IPFS Configuration
IPFS_URL=http://127.0.0.1:5001

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8080

# ------------------------------------------------------------------------------
# National identity verification. `demo` permits deterministic synthetic
# verification only while IS_DEMO=true; production requires `live`.
NATIONAL_ID_VERIFICATION_MODE=demo

# ------------------------------------------------------------------------------
# Telehealth Video (Phase 5.1)
# Provider: jitsi (default) | internal | daily | twilio
#   jitsi    — real WebRTC video via a Jitsi Meet server; NO API key required.
#              Rooms are created on join, so the URLs open a working call.
#   internal — self-hosted HMAC token URLs (needs your own room page).
#   daily    — Daily.co       (requires DAILY_API_KEY)
#   twilio   — Twilio Video   (requires TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN)
# ------------------------------------------------------------------------------
TELEHEALTH_PROVIDER=jitsi
# Demo-only default. Production rejects public Jitsi and missing room authentication.
JITSI_DOMAIN=meet.jit.si
JITSI_ROOM_PREFIX=MediChain
# Jitsi JWT auth (Phase 1) — ONLY works with a self-hosted Jitsi configured for
# Prosody token auth (or 8x8 JaaS). On public meet.jit.si these are ignored.
# Production requires JITSI_APP_ID and JITSI_APP_SECRET for private rooms.
# JITSI_APP_ID=medichain
# JITSI_APP_SECRET=change-me-to-your-prosody-app-secret
# Credentials for the SaaS providers (only needed if you select them):
# DAILY_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# InternalProvider tuning (only used when TELEHEALTH_PROVIDER=internal):
# TELEHEALTH_SECRET=medichain-telehealth-dev-secret
# MEDICHAIN_DOMAIN=app.medichain.health
# In-app web base for single-tap mobile join (QR / 302 redirect, Phase 4).
# The QR/redirect targets <MEDICHAIN_APP_URL>/telehealth?session=...&join=1 so
# phones open the consultation INSIDE the MediChain PWA — no native-app download.
# MEDICHAIN_APP_URL=https://app.medichain.health
# Recording transcription (Phase 6). "none" (default) = no transcription and no
# external key needed. "google" is wired (api/src/services/transcription.rs) —
# real Google Cloud Speech-to-Text v1 REST calls once GOOGLE_STT_API_KEY is set.
# "aws"/"azure" still need their own SDK. Also needs a signed BAA before use on
# real patient audio, and — separately — a server-side recording upload
# pipeline (recordings are currently client-side only, by design) before this
# can ever actually fire; see IMPLEMENTATION_PLAN.md 5.1 for the full context.
# TRANSCRIPTION_PROVIDER=none
# GOOGLE_STT_API_KEY=your-google-cloud-api-key

# ------------------------------------------------------------------------------
# Push Notifications — FCM (Phase 5.2)
# ------------------------------------------------------------------------------
# FCM_ENABLED=false (default) logs push notifications instead of sending them —
# safe for dev/demo with no credentials. Set true + provide a real Firebase
# project's service-account values to actually deliver:
# FCM_ENABLED=false
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_ACCESS_TOKEN=oauth2-access-token-from-service-account
#
# Frontend (client/.env, VITE_-prefixed — see client/shared/src/push.ts):
# subscribing a browser for push requires the SAME Firebase project's web
# config + a VAPID key (Firebase Console → Project Settings → Cloud Messaging).
# Unset (the default) = initPushNotifications() silently no-ops.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FCM_VAPID_KEY=

# ------------------------------------------------------------------------------
# Drug-interaction data pipeline (Phase 4.1)
# ------------------------------------------------------------------------------
# Optional path to an external JSON file of additional drug-drug interactions
# (e.g. converted from a licensed RxNorm/DrugBank export) that ADDS TO the
# built-in curated table (api/data/drug_interactions_builtin.json). See
# api/data/README.md for the schema and import steps. Unset = built-in table only.
# DRUG_INTERACTIONS_DATA_PATH=/etc/medichain/drug_interactions_overlay.json

# Reviewed organization/jurisdiction policy for second-pharmacist dispensing
# verification. No built-in controlled-substance list is inferred from
# is_controlled or a free-text schedule.
# DISPENSING_POLICY_PATH=C:\ProgramData\MediChain\dispensing-policy.json

# ------------------------------------------------------------------------------
# Incident response (Phase 11.4)
# ------------------------------------------------------------------------------
# Comma-separated phone number(s) (E.164) that receive an SMS when a breach is
# declared via POST /api/admin/security/breach. Requires Africa's Talking SMS
# config (AT_USERNAME + AT_API_KEY) to actually send; otherwise logged only.
# SECURITY_OFFICER_PHONE=+27123456789

# Comma-separated email address(es) (compliance/privacy officer, or the
# regulator's intake address) notified on the same breach declaration — the
# POPIA Information Regulator / HIPAA data-subject notification obligation.
# Sending requires SMTP_ENABLED=true; without it the email is logged, not sent
# (and real delivery still needs a mail transport wired into `send_email` in
# api/src/notifications.rs — see docs/INCIDENT_RESPONSE.md).
# REGULATOR_NOTIFICATION_EMAIL=privacy-officer@medichain.health
# SMTP_ENABLED=false

# Facility offset from UTC, in minutes. Appointment dates and times are stored
# as facility wall-clock (what the clinician or patient typed), so this is what
# turns them into an instant. Unset or wrong outside UTC and the telehealth join
# window plus appointment reminders are off by the real offset -- a patient at
# their actual appointment time is told the call is "not open to join yet".
#   120 = SAST (South Africa)   60 = WAT (Nigeria)   180 = EAT (Kenya)
CLINIC_UTC_OFFSET_MINUTES=120

# ------------------------------------------------------------------------------
# Emergency audit availability policy
# ------------------------------------------------------------------------------
# Conservative default: refuse break-glass PHI disclosure if its canonical
# access record cannot be persisted.
EMERGENCY_AUDIT_AVAILABILITY_MODE=deny
# Governance-approved alternative only. The path must be absolute and reside on
# durable storage; the max age is selected by the deployment's accountable
# clinical/privacy authority. Missing/invalid settings fail closed at startup.
# EMERGENCY_AUDIT_AVAILABILITY_MODE=durable_defer
# EMERGENCY_DEFERRED_AUDIT_DIR=C:\ProgramData\MediChain\deferred-emergency-audit
# EMERGENCY_DEFERRED_AUDIT_MAX_AGE_SECS=approved-positive-value
